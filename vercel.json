{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/pos", "destination": "/index.html" },
    { "source": "/api/:path*", "destination": "/api/index?__path=:path*" }
  ]
}
